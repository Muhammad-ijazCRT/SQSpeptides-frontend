# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Next.js 15)
# =============================================================================

# NestJS API Origin
# Local development: http://localhost:3001
# Production: Set to your deployed NestJS URL (e.g. https://your-backend.up.railway.app)
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_URL="http://localhost:3001"

# JWT Secret (MUST match the JWT_SECRET in backend/.env for middleware auth verification)
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"

# Canonical Site URL & Support Phone
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_PHONE="+19725551234"

# Crossmint Card On-ramp Integration (Optional)
NEXT_PUBLIC_CROSSMINT_CLIENT_SIDE_API_KEY=""
CROSSMINT_SERVER_SIDE_API_KEY=""
NEXT_PUBLIC_CROSSMINT_ENV="staging"
NEXT_PUBLIC_ONRAMP_RECIPIENT_WALLET=""
NEXT_PUBLIC_ONRAMP_RETURNING_EMAIL=""

# BFF Proxy Request Timeout (ms) for Server-to-Nest API calls
NEST_BFF_TIMEOUT_MS=120000

# Fallback catalog from local JSON if API is temporarily unavailable (1 to enable)
STORE_CATALOG_FALLBACK_JSON=1


# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Next.js 15)
# =============================================================================

NEXT_PUBLIC_API_URL="http://localhost:3001"
API_URL="http://localhost:3001"
JWT_SECRET="sqspeptides-super-secure-jwt-secret-key-32chars-min"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_PHONE="+19725551234"
NEST_BFF_TIMEOUT_MS=120000
STORE_CATALOG_FALLBACK_JSON=1
